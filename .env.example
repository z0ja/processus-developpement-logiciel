# Copier ce fichier en .env et adapter les valeurs.
DATABASE_URL="postgresql://pdl:pdl@localhost:5432/partage_fichiers?schema=public"

# Sur le serveur pedago (cf. README, « Déploiement ») : base commune `etd`, connexion par le
# socket local sans mot de passe, tables dans le schéma personnel du compte qui déploie.
# DATABASE_URL="postgresql://<login>@localhost/etd?host=/var/run/postgresql&schema=<login>"

# Répertoire de stockage local des fichiers uploadés (cf. ADR-001, points ouverts)
UPLOAD_DIR="./uploads"
