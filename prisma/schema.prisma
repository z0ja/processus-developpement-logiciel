// Schéma de données — cf. docs/decisions/adr-001-stack-technique.md
// Toute évolution passe par une migration : npx prisma migrate dev --name <nom>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Epic A — Comptes utilisateurs
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  files        File[]
  sessions     Session[]
  sharedWithMe FileShare[]
  fileVersions FileVersion[]
}

// US-A2 — Sessions de connexion. Seule l'empreinte SHA-256 du jeton est stockée :
// le jeton en clair n'existe que dans le cookie de l'utilisateur.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId])
}

// Epic B — Gestion des fichiers
// Les champs name / mimeType / size / storagePath décrivent toujours la version
// courante (US-G1) : téléchargement, ouverture et partage n'ont pas à connaître les versions.
model File {
  id          String   @id @default(cuid())
  name        String
  mimeType    String
  size        Int
  storagePath String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  version     Int      @default(1)

  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  shareLinks ShareLink[]
  shares     FileShare[]
  versions   FileVersion[]

  @@index([ownerId])
}

// US-G1 — Versions successives d'un fichier (la version courante incluse).
// Chaque version garde son propre contenu sur disque, pour l'historique (US-G2).
model FileVersion {
  id          String   @id @default(cuid())
  version     Int
  name        String
  mimeType    String
  size        Int
  storagePath String   @unique
  createdAt   DateTime @default(now())

  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String

  // Auteur de la version ; conservé à null si son compte est supprimé.
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  @@unique([fileId, version])
  @@index([authorId])
}

// Epic C — Partage de fichiers
model ShareLink {
  id        String    @id @default(cuid())
  token     String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  password  String?

  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String

  @@index([fileId])
}

// US-C2 — Partage direct d'un fichier avec un autre utilisateur du service.
// Un fichier ne peut être partagé qu'une fois avec un même destinataire.
model FileShare {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String

  recipient   User   @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String

  @@unique([fileId, recipientId])
  @@index([recipientId])
}
